# TNC Trading — variables d'environnement
#
# Ce fichier documente les secrets attendus. Il ne contient AUCUNE valeur réelle
# et ne doit jamais en contenir : en production, les secrets sont injectés par
#   npx wrangler secret put <NOM> --env production
# et non par un fichier.
#
# Pour savoir lesquels manquent sur un déploiement donné :
#   node scripts/readiness.mjs --url <api> --token <jwt admin>
#
# Voir docs/CONFIGURATION.md pour la procédure pas à pas.

# ── Obligatoires ─────────────────────────────────────────────────────────────

# Signature des jetons d'accès. Une chaîne aléatoire longue (>= 32 octets).
JWT_SECRET=

# Chiffrement AES-256-GCM des documents KYC/KYB et des secrets TOTP.
# FAIL-CLOSED : sans cette clé, tout dépôt de document est REFUSÉ.
ENCRYPTION_KEY=

# development | staging | production
# Hors "development", certains contrôles cessent d'accepter les raccourcis.
ENVIRONMENT=development

# Origines autorisées par le CORS, séparées par des virgules.
ALLOWED_ORIGINS=

# ── Amorçage initial (routes /setup/*) ───────────────────────────────────────
# Sans SETUP_SECRET, les routes d'amorçage sont désactivées (fail-closed).
# À retirer une fois le premier administrateur créé.
SETUP_SECRET=
SETUP_ADMIN_PASSWORD=
SETUP_STATE_PASSWORD=
SETUP_DEMO_PASSWORD=

# ── Prix de l'or et change ───────────────────────────────────────────────────
GOLD_API_KEY=
EXCHANGE_RATE_API_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Compte de service Firebase, JSON COMPLET sur une ligne, pour FCM HTTP v1.
# ATTENTION : une "clé serveur" FCM legacy ne convient pas — Google a coupé
# cet endpoint en juin 2024.
FCM_SERVICE_ACCOUNT=

# ── KYC ──────────────────────────────────────────────────────────────────────
SMILE_IDENTITY_API_KEY=
SMILE_IDENTITY_PARTNER_ID=

# ── Paiements ────────────────────────────────────────────────────────────────
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_ID=

MOOV_MONEY_API_KEY=
MOOV_API_KEY=
MOOV_MERCHANT_ID=

CINETPAY_API_KEY=
CINETPAY_SITE_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signature des webhooks entrants. Sans lui, toute confirmation est rejetée.
WEBHOOK_SECRET=

# ── Preuve de réserve ────────────────────────────────────────────────────────
# Clé privée JWK (EC P-256) signant les attestations de réserve.
# FAIL-CLOSED : sans elle, AUCUNE attestation n'est publiée — une attestation
# non signée aurait l'air officielle sans l'être.
# La clé PUBLIQUE correspondante se renseigne dans la config `attestation_public_jwk`.
ATTESTATION_SIGNING_JWK=

# ── Supervision ──────────────────────────────────────────────────────────────
SENTRY_DSN=
ALERT_EMAIL_RECIPIENTS=
ALERT_SMS_RECIPIENTS=
