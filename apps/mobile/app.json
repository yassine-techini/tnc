{
  "expo": {
    "name": "TNC Trading",
    "slug": "tnc-trading",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tnc-trading",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tnc.trading",
      "infoPlist": {
        "NSFaceIDUsageDescription": "TNC Trading utilise Face ID pour sécuriser l'accès à votre compte",
        "NSCameraUsageDescription": "TNC Trading utilise la caméra pour la vérification KYC",
        "NSPhotoLibraryUsageDescription": "TNC Trading utilise vos photos pour la vérification KYC"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F1A"
      },
      "package": "com.tnc.trading",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser TNC Trading a utiliser Face ID"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser TNC Trading a acceder a la camera"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "./plugins/withSSLPinning",
        {
          "domains": {
            "bf-api.tnc.trading": [
              "sha256/jQJTbIh0grw0/1TkHSumWb+Fs0Ggogr621gT3PvPKG0=",
              "sha256/5VLcahb6x4EvvFrCF2TePj8ZmM2w8h6vXhPvrTbU/qI="
            ],
            "tnc-trading-api-staging.yassine-techini.workers.dev": [
              "sha256/jQJTbIh0grw0/1TkHSumWb+Fs0Ggogr621gT3PvPKG0=",
              "sha256/5VLcahb6x4EvvFrCF2TePj8ZmM2w8h6vXhPvrTbU/qI="
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
