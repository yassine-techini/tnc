# TNC Trading API - Environment Variables
# Copy this file to .dev.vars for local development with Wrangler

# ============================================
# Core Settings
# ============================================
ENVIRONMENT=development

# ============================================
# JWT & Security
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# For encrypting sensitive data (KYC documents)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-256-bit-encryption-key-in-hex

# Webhook signature verification
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-key

# ============================================
# Gold Price API
# ============================================
# Get from https://www.goldapi.io/
GOLD_API_KEY=your-goldapi-key

# Exchange rate fallback API (optional)
# Get from https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# ============================================
# KYC Provider (Smile Identity)
# ============================================
# Get from https://portal.smileidentity.com/
SMILE_IDENTITY_API_KEY=your-smile-identity-api-key
SMILE_IDENTITY_PARTNER_ID=your-partner-id

# ============================================
# Payment Providers
# ============================================

# Orange Money Burkina Faso
# Contact Orange Business for credentials
ORANGE_MONEY_API_KEY=your-orange-money-api-key
ORANGE_MONEY_MERCHANT_ID=your-merchant-id
ORANGE_MONEY_CLIENT_ID=your-client-id
ORANGE_MONEY_CLIENT_SECRET=your-client-secret

# Moov Money Burkina Faso
# Contact Moov Business for credentials
MOOV_API_KEY=your-moov-api-key
MOOV_MERCHANT_ID=your-moov-merchant-id
MOOV_MONEY_API_KEY=your-moov-money-api-key

# CinetPay (Card payments)
# Get from https://cinetpay.com/
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id

# ============================================
# Notifications
# ============================================

# Twilio (SMS)
# Get from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Resend (Email - primary)
# Get from https://resend.com/
RESEND_API_KEY=your-resend-api-key

# SendGrid (Email - fallback)
# Get from https://sendgrid.com/
SENDGRID_API_KEY=your-sendgrid-api-key

# Firebase Cloud Messaging (Push notifications)
# Get from Firebase Console
FCM_SERVER_KEY=your-fcm-server-key

# ============================================
# Cloudflare Access (Admin/State Portals)
# ============================================
# Configure at https://one.dash.cloudflare.com/
CF_ACCESS_TEAM_DOMAIN=tnc-trading
CF_ACCESS_AUDIENCE=your-admin-audience-tag
CF_ACCESS_STATE_AUDIENCE=your-state-portal-audience-tag

# ============================================
# NOTES
# ============================================
#
# For local development:
# 1. Copy this file to .dev.vars
# 2. Fill in the required values
# 3. Run: pnpm dev
#
# For production deployment:
# 1. Use wrangler secret put <SECRET_NAME>
# 2. Or configure via Cloudflare Dashboard
#
# Required secrets for production:
# - JWT_SECRET
# - ENCRYPTION_KEY
# - WEBHOOK_SECRET
# - GOLD_API_KEY
# - SMILE_IDENTITY_API_KEY
# - SMILE_IDENTITY_PARTNER_ID
# - ORANGE_MONEY_* (all 4)
# - MOOV_* (all 3)
# - CINETPAY_* (all 2)
# - TWILIO_* (all 3)
# - RESEND_API_KEY or SENDGRID_API_KEY
# - CF_ACCESS_* (all 3)
